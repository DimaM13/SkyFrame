{
  "file_format_version": "1.0.0",
  "layer": {
    "name": "VK_LAYER_SKYFRAME_framegen",
    "type": "GLOBAL",
    "library_path": "/home/deck/homebrew/plugins/SkyFrame/bin/libVkLayer_skyframe.so",
    "api_version": "1.3.0",
    "implementation_version": "1",
    "description": "SkyFrame Native AI Frame Generation Layer for SteamOS (Vulkan FastWarp + RIFE)",
    "functions": {
      "vkGetInstanceProcAddr": "skyframe_GetInstanceProcAddr",
      "vkGetDeviceProcAddr": "skyframe_GetDeviceProcAddr"
    },
    "enable_environment": {
      "ENABLE_SKYFRAME": "1"
    },
    "disable_environment": {
      "DISABLE_SKYFRAME": "1"
    }
  }
}
