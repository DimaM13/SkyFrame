#!/usr/bin/env bash
# SkyFrame launcher - isolated wrapper for one game (MAKO-style).
# Usage in Steam launch options:
#   /home/deck/.local/bin/skyframe-run %command%
#   /home/deck/.local/bin/skyframe-run --debug %command%
set -u

DEBUG=0
if [ "${1:-}" = "--debug" ]; then
  DEBUG=1
  shift
fi

# Isolate from competing FG layers for THIS game only (no global uninstall).
unset ENABLE_LSFGVK
unset ENABLE_MAKO
export DISABLE_LSFGVK=1
export DISABLE_MAKO=1
export DISABLE_LSFGVK_FRAME_GENERATION=1
export ENABLE_SKYFRAME=1
unset DISABLE_SKYFRAME

# Keep SkyFrame config discovery stable under Steam runtime.
if [ -z "${LSFG_CONFIG:-}" ] && [ -f "$HOME/.config/lsfg-vk/conf.toml" ]; then
  export LSFG_CONFIG="$HOME/.config/lsfg-vk/conf.toml"
fi

LOG="$HOME/skyframe_game.log"
if [ "$DEBUG" = "1" ]; then
  {
    echo "=== [skyframe-run] $(date -u +%FT%TZ) ==="
    echo "[skyframe-run] cmd: $*"
    echo "[skyframe-run] env: ENABLE_SKYFRAME=${ENABLE_SKYFRAME:-<unset>} DISABLE_SKYFRAME=${DISABLE_SKYFRAME:-<unset>} LSFG_CONFIG=${LSFG_CONFIG:-<default>}"
    echo "[skyframe-run] manifests:"
    ls -la "$HOME/.local/share/vulkan/implicit_layer.d/" 2>&1
    echo "[skyframe-run] conf head:"
    head -12 "${LSFG_CONFIG:-$HOME/.config/lsfg-vk/conf.toml}" 2>&1
    echo "[skyframe-run] libs:"
    ls -la "$HOME/.local/lib/liblsfg-vk-layer.so" "$HOME/.local/lib/liblsfg-vk-layer_32.so" "$HOME/.local/bin/lsfg-vk-cli" 2>&1
  } >> "$LOG" 2>&1
  # NOTE: append (>>) — truncate (>) стирал бы диагностику выше.
  exec "$@" >> "$LOG" 2>&1
else
  exec "$@"
fi
