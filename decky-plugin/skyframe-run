#!/usr/bin/env bash
# SkyFrame launcher - isolated wrapper for one game (MAKO-style).
# Usage in Steam launch options:
#   /home/deck/.local/bin/skyframe-run %command%
#   /home/deck/.local/bin/skyframe-run --debug %command%
set -u

DEBUG=0
if [ "${1:-}" = "--debug" ]; then
  DEBUG=1
  shift
fi

# Both SkyFrame layers are gated per-game (never global):
#   ENABLE_SKYFRAME=1 -> our present-tap (live HUD stats, forward-only)
#   ENABLE_LSFGVK=1   -> official 2.0.0 FG core (actual frame generation)
# Competing FG stacks stay off for this game only (no global uninstall).
export ENABLE_SKYFRAME=1
export ENABLE_LSFGVK=1
unset DISABLE_SKYFRAME
export DISABLE_MAKO=1
export DISABLE_LSFGVK_FRAME_GENERATION=1
# Surgical per-game guard: silence known foreign FG layers by NAME so they
# can never double-chain with ours (our own manifests above stay enabled).
# Covers manual official installs (.x86) and a globally-armed MAKO.
export VK_LOADER_LAYERS_DISABLE="VK_LAYER_LSFGVK_frame_generation_x86,VK_LAYER_MAKO_render"

# Keep SkyFrame config discovery stable under Steam runtime.
if [ -z "${LSFG_CONFIG:-}" ] && [ -f "$HOME/.config/lsfg-vk/conf.toml" ]; then
  export LSFG_CONFIG="$HOME/.config/lsfg-vk/conf.toml"
fi

# Pin the Default profile via override (LSFGVK_PROFILE is documented in
# official 2.0.0 env docs and beats exe-name matching for every game).
export LSFGVK_PROFILE=Default

# SkyFrame tap pacing from the UI config (decky-plugin/main.py wrote
# ~/.config/skyframe/{config.json,skyframe.toml}).
#   Balanced/Smooth (anything but "none"): cap the BASE to the exact
#     divisor (target_hz / multiplier, e.g. 60/2=30) + output grid at hz.
#   Low-lag ("none"): tap measures only, no holds.
# The tap autodetects its chain position (base vs FG output), so these
# are safe from either side of the official FG layer.
if command -v python3 >/dev/null 2>&1; then
  SKY_TAP_ENV="$(python3 - "$HOME/.config/skyframe/config.json" <<'PYEOF'
import json, sys
try:
    cfg = json.load(open(sys.argv[1]))
except Exception:
    cfg = {}
mode, hz, mult = "smooth", 60, 2
try:
    mult = int(cfg.get("multiplier", 2))
    hz = int(cfg.get("target_hz", 60))
    pacing = str(cfg.get("pacing", "smooth"))
    if pacing in ("vsync", "smooth", "none"):
        mode = pacing
except Exception:
    pass
if mult not in (2, 3, 4):
    mult = 2
hz = max(30, min(240, hz))
if mode != "none":
    print(f"SKYFRAME_LIMIT_FPS={hz / mult:.2f}")
    print(f"SKYFRAME_OUT_HZ={hz}")
PYEOF
)"
  if [ -n "$SKY_TAP_ENV" ]; then
    while IFS= read -r line; do
      case "$line" in SKYFRAME_*=*) export "$line" ;; esac
    done <<< "$SKY_TAP_ENV"
  fi
fi

LOG="$HOME/skyframe_game.log"
if [ "$DEBUG" = "1" ]; then
  {
    echo "=== [skyframe-run] $(date -u +%FT%TZ) ==="
    echo "[skyframe-run] cmd: $*"
    echo "[skyframe-run] env: ENABLE_SKYFRAME=${ENABLE_SKYFRAME:-<unset>} ENABLE_LSFGVK=${ENABLE_LSFGVK:-<unset>} LSFGVK_PROFILE=${LSFGVK_PROFILE:-<unset>} LIMIT=${SKYFRAME_LIMIT_FPS:-off} OUT=${SKYFRAME_OUT_HZ:-off} LSFG_CONFIG=${LSFG_CONFIG:-<default>}"
    echo "[skyframe-run] manifests:"
    ls -la "$HOME/.local/share/vulkan/implicit_layer.d/" 2>&1
    echo "[skyframe-run] conf head:"
    head -12 "${LSFG_CONFIG:-$HOME/.config/lsfg-vk/conf.toml}" 2>&1
    echo "[skyframe-run] libs:"
    ls -la "$HOME/.local/lib/liblsfg-vk-layer.so" "$HOME/.local/lib/liblsfg-vk-layer_32.so" "$HOME/.local/lib/libskyframe-shim.so" "$HOME/.local/lib/libskyframe-shim_32.so" "$HOME/.local/bin/lsfg-vk-cli" 2>&1
  } >> "$LOG" 2>&1
  # NOTE: append (>>) — truncate (>) стирал бы диагностику выше.
  exec "$@" >> "$LOG" 2>&1
else
  exec "$@"
fi
