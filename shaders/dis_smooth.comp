#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform readonly image2D u_RawFlow;
layout(binding = 1, rgba8)    uniform readonly image2D u_Frame0;
layout(binding = 2, rgba16f) uniform writeonly image2D u_DenseFlow;

layout(push_constant) uniform SmoothPushConstants {
    int full_width;   // e.g. 1280
    int full_height;  // e.g. 800
    int dense_width;  // dynamic (e.g. 1152 at 90%)
    int dense_height; // dynamic (e.g. 720 at 90%)
    int raw_width;    // e.g. 320
    int raw_height;   // e.g. 200
} pc;

float rgbToLuma(vec3 c) {
    return dot(c, vec3(0.299, 0.587, 0.114));
}

vec4 sampleRawFlowBilinear(vec2 normCoord, ivec2 rawSize) {
    vec2 pos = normCoord * vec2(rawSize) - 0.5;
    pos = clamp(pos, vec2(0.0), vec2(rawSize - 1));
    ivec2 i0 = ivec2(floor(pos));
    ivec2 i1 = min(i0 + ivec2(1, 1), rawSize - 1);
    vec2 f = fract(pos);

    vec4 v00 = imageLoad(u_RawFlow, ivec2(i0.x, i0.y));
    vec4 v10 = imageLoad(u_RawFlow, ivec2(i1.x, i0.y));
    vec4 v01 = imageLoad(u_RawFlow, ivec2(i0.x, i1.y));
    vec4 v11 = imageLoad(u_RawFlow, ivec2(i1.x, i1.y));

    return mix(mix(v00, v10, f.x), mix(v01, v11, f.x), f.y);
}

// 8 neighbor offsets for Laplacian / Bilateral diffusion
const ivec2 kNeighbors[8] = ivec2[8](
    ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1),
    ivec2(-1, -1), ivec2(1, -1), ivec2(-1, 1), ivec2(1, 1)
);

void main() {
    ivec2 denseCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 denseSize  = ivec2(pc.dense_width, pc.dense_height);
    if (denseCoord.x >= denseSize.x || denseCoord.y >= denseSize.y) {
        return;
    }

    ivec2 rawSize  = ivec2(pc.raw_width, pc.raw_height);
    ivec2 fullSize = ivec2(pc.full_width, pc.full_height);
    ivec2 maxFull  = fullSize - ivec2(1, 1);

    // 1. Normalized continuous coordinate
    vec2 normCoord = (vec2(denseCoord) + 0.5) / vec2(denseSize);
    ivec2 centerPix = clamp(ivec2(round(normCoord * vec2(fullSize) - 0.5)), ivec2(0), maxFull);

    // Reference center color and raw flow data
    vec3 centerColor = imageLoad(u_Frame0, centerPix).rgb;
    float centerLuma = rgbToLuma(centerColor);

    vec4 centerData = sampleRawFlowBilinear(normCoord, rawSize);
    vec2 centerVec  = centerData.xy;
    float residual  = centerData.z;

    // 2. Variational TV-L1 Elastic Diffusion Filter across 8 neighbors
    // Replaces isolated outlier vectors with the consensus of the surrounding motion sheet
    vec2 sumFlow = centerVec * 0.75; // Data term weight
    float sumWeight = 0.75;

    vec2 uvStep = 1.0 / vec2(denseSize);

    for (int i = 0; i < 8; ++i) {
        ivec2 offset = kNeighbors[i];
        vec2 nUV = clamp(normCoord + vec2(offset) * uvStep * 1.5, vec2(0.0), vec2(1.0));
        vec4 nData = sampleRawFlowBilinear(nUV, rawSize);

        ivec2 nPix = clamp(centerPix + offset * 2, ivec2(0), maxFull);
        vec3 nColor = imageLoad(u_Frame0, nPix).rgb;
        float nLuma = rgbToLuma(nColor);

        // Bilateral affinity: high on same surface, low across object silhouette edges
        float lumaDiff = abs(centerLuma - nLuma);
        float colorDiff = dot(abs(centerColor - nColor), vec3(1.0)) * 0.333;
        float flowDist  = length(centerVec - nData.xy);

        // Edge-preserving weight: preserves sharp motion boundaries, smooths out noise
        float spatialWeight = (i < 4) ? 1.0 : 0.707; // Manhattan vs diagonal
        float edgeWeight = exp(-colorDiff * 6.0 - lumaDiff * 4.0);
        float coherenceWeight = exp(-flowDist * 0.12);

        float w = spatialWeight * edgeWeight * coherenceWeight;
        sumFlow += nData.xy * w;
        sumWeight += w;
    }

    vec2 smoothedVec = sumFlow / max(sumWeight, 1e-5);

    // 3. Continuous soft occlusion factor
    // Smooth transition between 0.30 and 1.0 without sharp threshold steps
    float occ = clamp(1.0 - smoothstep(0.06, 0.32, residual), 0.30, 1.0);

    // Store in dense flow texture (RGBA16F)
    imageStore(u_DenseFlow, denseCoord, vec4(smoothedVec, residual, occ));
}
