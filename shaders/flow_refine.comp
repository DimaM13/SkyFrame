#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba8) uniform readonly image2D u_Frame0;
layout(binding = 1, rgba8) uniform readonly image2D u_Frame1;
layout(binding = 2, rgba16f) uniform readonly image2D u_CoarseFlow;
layout(binding = 3, rgba16f) uniform writeonly image2D u_DenseFlow;

layout(push_constant) uniform RefinePushConstants {
    int full_width;   // e.g. 1280
    int full_height;  // e.g. 800
    int dense_width;  // dynamic (e.g. 1152 at 90%)
    int dense_height; // dynamic (e.g. 720 at 90%)
    int coarse_width; // e.g. 80
    int coarse_height;// e.g. 50
} pc;

float rgbToLuma(vec3 c) {
    return dot(c, vec3(0.299, 0.587, 0.114));
}

vec2 sampleCoarseFlowBilinear(vec2 normCoord, ivec2 coarseSize) {
    vec2 coarsePos = normCoord * vec2(coarseSize) - 0.5;
    coarsePos = clamp(coarsePos, vec2(0.0), vec2(coarseSize - 1));
    ivec2 i0 = ivec2(floor(coarsePos));
    ivec2 i1 = min(i0 + ivec2(1, 1), coarseSize - 1);
    vec2 f = fract(coarsePos);

    vec2 v00 = imageLoad(u_CoarseFlow, ivec2(i0.x, i0.y)).xy;
    vec2 v10 = imageLoad(u_CoarseFlow, ivec2(i1.x, i0.y)).xy;
    vec2 v01 = imageLoad(u_CoarseFlow, ivec2(i0.x, i1.y)).xy;
    vec2 v11 = imageLoad(u_CoarseFlow, ivec2(i1.x, i1.y)).xy;

    return mix(mix(v00, v10, f.x), mix(v01, v11, f.x), f.y);
}

const vec2 kFineDeltas[13] = vec2[13](
    vec2(0.0, 0.0),
    vec2(-1.0, 0.0), vec2(1.0, 0.0),
    vec2(0.0, -1.0), vec2(0.0, 1.0),
    vec2(-1.0, -1.0), vec2(1.0, -1.0),
    vec2(-1.0, 1.0), vec2(1.0, 1.0),
    vec2(-2.0, 0.0), vec2(2.0, 0.0),
    vec2(0.0, -2.0), vec2(0.0, 2.0)
);

const ivec2 kRefineTaps[5] = ivec2[5](
    ivec2(0, 0),
    ivec2(-1, 0), ivec2(1, 0),
    ivec2(0, -1), ivec2(0, 1)
);

void main() {
    ivec2 denseCoord = ivec2(gl_GlobalInvocationID.xy);
    if (denseCoord.x >= pc.dense_width || denseCoord.y >= pc.dense_height) {
        return;
    }

    ivec2 coarseSize = ivec2(pc.coarse_width, pc.coarse_height);
    ivec2 fullSize = ivec2(pc.full_width, pc.full_height);
    ivec2 maxFullCoord = fullSize - ivec2(1, 1);

    // 1. Bilinearly sample coarse motion vector as continuous baseline
    vec2 normCoord = (vec2(denseCoord) + 0.5) / vec2(pc.dense_width, pc.dense_height);
    vec2 baseVec = sampleCoarseFlowBilinear(normCoord, coarseSize);

    // 2. Continuous center pixel in full resolution
    ivec2 basePixel = clamp(ivec2(round(normCoord * vec2(fullSize) - 0.5)), ivec2(0), maxFullCoord);
    float bestDiff = 1e9;
    vec2 bestVec = baseVec;

    // Evaluate 13 fine subpixel candidate vectors around baseVec
    for (int i = 0; i < 13; ++i) {
        vec2 testVec = baseVec + kFineDeltas[i];
        float diff = 0.0;
        for (int s = 0; s < 5; ++s) {
            ivec2 p1 = clamp(basePixel + kRefineTaps[s], ivec2(0), maxFullCoord);
            ivec2 p0 = clamp(ivec2(round(vec2(p1) - testVec)), ivec2(0), maxFullCoord);
            vec3 c1 = imageLoad(u_Frame1, p1).rgb;
            vec3 c0 = imageLoad(u_Frame0, p0).rgb;
            diff += abs(rgbToLuma(c1) - rgbToLuma(c0)) + 0.25 * dot(abs(c1 - c0), vec3(1.0));
        }
        if (diff < bestDiff) {
            bestDiff = diff;
            bestVec = testVec;
        }
    }

    // Also evaluate static zero motion candidate
    float zeroDiff = 0.0;
    for (int s = 0; s < 5; ++s) {
        ivec2 p = clamp(basePixel + kRefineTaps[s], ivec2(0), maxFullCoord);
        vec3 c1 = imageLoad(u_Frame1, p).rgb;
        vec3 c0 = imageLoad(u_Frame0, p).rgb;
        zeroDiff += abs(rgbToLuma(c1) - rgbToLuma(c0)) + 0.25 * dot(abs(c1 - c0), vec3(1.0));
    }
    if (zeroDiff < bestDiff && zeroDiff < 0.05) {
        bestDiff = zeroDiff;
        bestVec = vec2(0.0, 0.0);
    }

    // 3. Occlusion and confidence metric
    vec3 c1_center = imageLoad(u_Frame1, basePixel).rgb;
    vec3 c0_center = imageLoad(u_Frame0, basePixel).rgb;
    float temporalDiff = dot(abs(c1_center - c0_center), vec3(0.299, 0.587, 0.114));

    float occ = 1.0;
    if (bestDiff > 0.25 && bestDiff > temporalDiff) {
        occ = clamp(1.0 - smoothstep(0.12, 0.40, bestDiff), 0.20, 1.0);
    }

    imageStore(u_DenseFlow, denseCoord, vec4(bestVec, bestDiff, occ));
}
