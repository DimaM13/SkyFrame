#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba8) uniform readonly image2D u_Frame0;
layout(binding = 1, rgba8) uniform readonly image2D u_Frame1;
layout(binding = 2, rgba16f) uniform readonly image2D u_CoarseFlow;
layout(binding = 3, rgba16f) uniform writeonly image2D u_DenseFlow;

layout(push_constant) uniform RefinePushConstants {
    int full_width;   // 1280
    int full_height;  // 800
    int dense_width;  // 320
    int dense_height; // 200
    int coarse_width; // 80
    int coarse_height;// 50
} pc;

float rgbToLuma(vec3 c) {
    return dot(c, vec3(0.299, 0.587, 0.114));
}

vec2 sampleCoarseFlowBilinear(vec2 denseCoord, ivec2 coarseSize) {
    // 4 dense blocks correspond to 1 coarse block. Block centers align at (denseCoord - 1.5) / 4.0.
    vec2 coarsePos = (denseCoord - vec2(1.5)) * 0.25;
    coarsePos = clamp(coarsePos, vec2(0.0), vec2(coarseSize - 1));
    ivec2 i0 = ivec2(floor(coarsePos));
    ivec2 i1 = min(i0 + ivec2(1, 1), coarseSize - 1);
    vec2 f = fract(coarsePos);

    vec2 v00 = imageLoad(u_CoarseFlow, ivec2(i0.x, i0.y)).xy;
    vec2 v10 = imageLoad(u_CoarseFlow, ivec2(i1.x, i0.y)).xy;
    vec2 v01 = imageLoad(u_CoarseFlow, ivec2(i0.x, i1.y)).xy;
    vec2 v11 = imageLoad(u_CoarseFlow, ivec2(i1.x, i1.y)).xy;

    return mix(mix(v00, v10, f.x), mix(v01, v11, f.x), f.y);
}

const ivec2 kFineDeltas[9] = ivec2[9](
    ivec2(0, 0),
    ivec2(-1, 0), ivec2(1, 0),
    ivec2(0, -1), ivec2(0, 1),
    ivec2(-2, 0), ivec2(2, 0),
    ivec2(0, -2), ivec2(0, 2)
);

const ivec2 kBlockSamples[4] = ivec2[4](
    ivec2(0, 0), ivec2(2, 0),
    ivec2(1, 2), ivec2(3, 2)
);

void main() {
    ivec2 denseCoord = ivec2(gl_GlobalInvocationID.xy);
    if (denseCoord.x >= pc.dense_width || denseCoord.y >= pc.dense_height) {
        return;
    }

    ivec2 coarseSize = ivec2(pc.coarse_width, pc.coarse_height);
    ivec2 fullSize = ivec2(pc.full_width, pc.full_height);
    ivec2 maxFullCoord = fullSize - ivec2(1, 1);

    // 1. Bilinearly sample the coarse motion vector as baseline
    vec2 baseVec = sampleCoarseFlowBilinear(vec2(denseCoord), coarseSize);

    // 2. Fine local refinement around baseVec (testing 9 local sub-pixel deltas)
    ivec2 basePixel = denseCoord * 4;
    float bestDiff = 1e9;
    vec2 bestVec = baseVec;

    for (int i = 0; i < 9; ++i) {
        vec2 testVec = baseVec + vec2(kFineDeltas[i]);
        float diff = 0.0;
        for (int s = 0; s < 4; ++s) {
            ivec2 p1 = clamp(basePixel + kBlockSamples[s], ivec2(0), maxFullCoord);
            ivec2 p0 = clamp(ivec2(round(vec2(p1) - testVec)), ivec2(0), maxFullCoord);
            vec3 c1 = imageLoad(u_Frame1, p1).rgb;
            vec3 c0 = imageLoad(u_Frame0, p0).rgb;
            diff += abs(rgbToLuma(c1) - rgbToLuma(c0)) + 0.2 * dot(abs(c1 - c0), vec3(1.0));
        }
        if (diff < bestDiff) {
            bestDiff = diff;
            bestVec = testVec;
        }
    }

    // 3. Occlusion and confidence metric
    vec3 c1_center = imageLoad(u_Frame1, clamp(basePixel + ivec2(2, 2), ivec2(0), maxFullCoord)).rgb;
    vec3 c0_center = imageLoad(u_Frame0, clamp(basePixel + ivec2(2, 2), ivec2(0), maxFullCoord)).rgb;
    float temporalDiff = dot(abs(c1_center - c0_center), vec3(0.299, 0.587, 0.114));

    float occ = 1.0;
    if (bestDiff > 0.30 && bestDiff > temporalDiff) {
        occ = clamp(1.0 - smoothstep(0.15, 0.45, bestDiff), 0.15, 1.0);
    }

    imageStore(u_DenseFlow, denseCoord, vec4(bestVec, bestDiff, occ));
}
