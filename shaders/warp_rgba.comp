#version 450
layout(local_size_x = 16, local_size_y = 16) in;

// Frame 0 (Previous game frame) and Frame 1 (Current game frame)
layout(binding = 0) uniform sampler2D u_Frame0;
layout(binding = 1) uniform sampler2D u_Frame1;

// Optical flow vectors from FlowNet (R = flow_x, G = flow_y in normalized coordinates)
layout(binding = 2) uniform sampler2D u_Flow;

// Occlusion and confidence mask from FlowNet (R = mask)
layout(binding = 3) uniform sampler2D u_Mask;

// Output synthesized game frame (RGBA8/BGRA8)
layout(binding = 4, rgba8) uniform writeonly image2D u_OutImage;

layout(push_constant) uniform PushConstants {
    float time_step;       // Intermediate phase: 0.5 for 2x interpolation
    int   hud_protection;  // 1 = enabled, 0 = disabled
    float hud_threshold;   // Threshold to detect static HUD (e.g. 0.08)
    int   width;
    int   height;
    int   show_hud;        // 1 = show visual marker dot
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= pc.width || coord.y >= pc.height) {
        return;
    }

    if (pc.show_hud == 1 && coord.x < 14 && coord.y < 14) {
        imageStore(u_OutImage, coord, vec4(0.0, 1.0, 0.0, 1.0));
        return;
    }

    vec2 texCoord = (vec2(coord) + 0.5) / vec2(pc.width, pc.height);

    // 1. Sample bidirectional optical flow vectors (hardware bilinear filtering)
    vec4 flow_data = texture(u_Flow, texCoord);
    vec2 flow_forward  = flow_data.xy; // Motion from Frame 0 to Frame 1

    // 2. HUD & UI Protection:
    // If pixel color between Frame 0 and Frame 1 at exact same coordinate is nearly identical,
    // but optical flow is fast (moving camera / background), this pixel is static HUD.
    vec4 raw0_here = texture(u_Frame0, texCoord);
    vec4 raw1_here = texture(u_Frame1, texCoord);
    float color_diff = dot(abs(raw0_here.rgb - raw1_here.rgb), vec3(0.299, 0.587, 0.114));
    float motion_speed = length(flow_forward);

    bool is_static_hud = false;
    if (pc.hud_protection == 1) {
        if (color_diff < pc.hud_threshold && motion_speed > 0.015) {
            is_static_hud = true;
        }
    }

    if (is_static_hud) {
        // Retain sharp, un-warped UI element
        vec4 hud_color = mix(raw0_here, raw1_here, pc.time_step);
        imageStore(u_OutImage, coord, hud_color);
        return;
    }

    // 3. Compute warped texture coordinates
    vec2 coord0 = texCoord - flow_forward * pc.time_step;
    vec2 coord1 = texCoord + flow_forward * (1.0 - pc.time_step);

    // Clamp coordinates to texture boundaries
    coord0 = clamp(coord0, vec2(0.0), vec2(1.0));
    coord1 = clamp(coord1, vec2(0.0), vec2(1.0));

    // 4. Sample warped frames using hardware bilinear filtering
    vec4 c0 = texture(u_Frame0, coord0);
    vec4 c1 = texture(u_Frame1, coord1);

    // 5. Sample occlusion mask
    float mask = texture(u_Mask, texCoord).r;

    // Temporal blend weighted by time_step and occlusion confidence
    float weight1 = pc.time_step * (1.0 - mask) + mask * 0.5;
    weight1 = clamp(weight1, 0.0, 1.0);
    vec4 final_color = mix(c0, c1, weight1);

    imageStore(u_OutImage, coord, final_color);
}
