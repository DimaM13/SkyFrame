#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba8) uniform readonly image2D u_Frame0;
layout(binding = 1, rgba8) uniform readonly image2D u_Frame1;
layout(binding = 2, r32f)  uniform writeonly image2D u_Luma0;
layout(binding = 3, r32f)  uniform writeonly image2D u_Luma1;

layout(push_constant) uniform DownPushConstants {
    int in_width;
    int in_height;
    int out_width;
    int out_height;
} pc;

float rgbToLuma(vec3 c) {
    return dot(c, vec3(0.299, 0.587, 0.114));
}

void main() {
    ivec2 outCoord = ivec2(gl_GlobalInvocationID.xy);
    if (outCoord.x >= pc.out_width || outCoord.y >= pc.out_height) {
        return;
    }

    ivec2 baseIn = outCoord * 4;
    ivec2 maxIn = ivec2(pc.in_width - 1, pc.in_height - 1);

    float sum0 = 0.0;
    float sum1 = 0.0;

    // 4x4 box average (16 samples per low-res pixel)
    for (int dy = 0; dy < 4; ++dy) {
        for (int dx = 0; dx < 4; ++dx) {
            ivec2 p = min(baseIn + ivec2(dx, dy), maxIn);
            sum0 += rgbToLuma(imageLoad(u_Frame0, p).rgb);
            sum1 += rgbToLuma(imageLoad(u_Frame1, p).rgb);
        }
    }

    imageStore(u_Luma0, outCoord, vec4(sum0 * (1.0 / 16.0), 0.0, 0.0, 0.0));
    imageStore(u_Luma1, outCoord, vec4(sum1 * (1.0 / 16.0), 0.0, 0.0, 0.0));
}
