#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform readonly image2D u_Grad0;
layout(binding = 1, r32f)    uniform readonly image2D u_Luma1;
layout(binding = 2, rgba16f) uniform writeonly image2D u_RawFlow;

layout(push_constant) uniform SearchPushConstants {
    int grad_width;   // e.g. 320
    int grad_height;  // e.g. 200
    int full_width;   // e.g. 1280
    int full_height;  // e.g. 800
} pc;

float sampleLuma1Bilinear(vec2 pos, ivec2 size) {
    pos = clamp(pos, vec2(0.0), vec2(size - 1));
    ivec2 i0 = ivec2(floor(pos));
    ivec2 i1 = min(i0 + ivec2(1, 1), size - 1);
    vec2 f = fract(pos);
    float c00 = imageLoad(u_Luma1, ivec2(i0.x, i0.y)).r;
    float c10 = imageLoad(u_Luma1, ivec2(i1.x, i0.y)).r;
    float c01 = imageLoad(u_Luma1, ivec2(i0.x, i1.y)).r;
    float c11 = imageLoad(u_Luma1, ivec2(i1.x, i1.y)).r;
    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

// 64 multi-speed coarse candidate vectors covering up to 34 low-res px (136 full-res px)
const vec2 kCoarseCandidates[64] = vec2[64](
    vec2(0.0, 0.0), vec2(-2.0, 0.0), vec2(2.0, 0.0), vec2(0.0, -2.0),
    vec2(0.0, 2.0), vec2(-2.5, -2.5), vec2(2.5, -2.5), vec2(-2.5, 2.5),
    vec2(2.5, 2.5), vec2(-5.0, 0.0), vec2(5.0, 0.0), vec2(0.0, -5.0),
    vec2(0.0, 5.0), vec2(-6.0, -4.0), vec2(6.0, -4.0), vec2(-6.0, 4.0),
    vec2(6.0, 4.0), vec2(-9.0, 0.0), vec2(9.0, 0.0), vec2(-13.0, 0.0),
    vec2(13.0, 0.0), vec2(0.0, -9.0), vec2(0.0, 9.0), vec2(0.0, -13.0),
    vec2(0.0, 13.0), vec2(-10.0, -6.0), vec2(10.0, -6.0), vec2(-10.0, 6.0),
    vec2(10.0, 6.0), vec2(-17.0, 0.0), vec2(17.0, 0.0), vec2(-21.0, 0.0),
    vec2(21.0, 0.0), vec2(0.0, -17.0), vec2(0.0, 17.0), vec2(0.0, -21.0),
    vec2(0.0, 21.0), vec2(-16.0, -8.0), vec2(16.0, -8.0), vec2(-16.0, 8.0),
    vec2(16.0, 8.0), vec2(-18.0, -14.0), vec2(18.0, -14.0), vec2(-18.0, 14.0),
    vec2(18.0, 14.0), vec2(-26.0, 0.0), vec2(26.0, 0.0), vec2(-30.0, 0.0),
    vec2(30.0, 0.0), vec2(-34.0, 0.0), vec2(34.0, 0.0), vec2(0.0, -26.0),
    vec2(0.0, 26.0), vec2(-24.0, -12.0), vec2(24.0, -12.0), vec2(-24.0, 12.0),
    vec2(24.0, 12.0), vec2(-28.0, -10.0), vec2(28.0, -10.0), vec2(-28.0, 10.0),
    vec2(28.0, 10.0), vec2(-30.0, -16.0), vec2(30.0, -16.0), vec2(-30.0, 16.0)
);

// 9-point cross stencil for patch evaluation (dx, dy in [-2..2])
const ivec2 kPatchOffsets[9] = ivec2[9](
    ivec2(0, 0),
    ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1),
    ivec2(-2, -2), ivec2(2, -2), ivec2(-2, 2), ivec2(2, 2)
);

// Shared memory for workgroup-level coarse reduction
shared float s_candSAD[64];
shared int   s_candIdx[64];
shared vec2  s_bestCoarseVector;

void main() {
    ivec2 size  = ivec2(pc.grad_width, pc.grad_height);
    ivec2 tileOrigin = ivec2(gl_WorkGroupID.xy) * 8;
    uint  tid = gl_LocalInvocationIndex; // 0..63

    // 1. Workgroup-wide collaborative coarse motion search
    // Thread `tid` evaluates candidate `kCoarseCandidates[tid]` over the 8x8 tile
    vec2 cand = kCoarseCandidates[tid];
    float sad = 0.0;

    // 5 anchor samples across the 8x8 tile
    ivec2 anchors[5] = ivec2[5](
        tileOrigin + ivec2(4, 4),
        tileOrigin + ivec2(1, 1),
        tileOrigin + ivec2(6, 1),
        tileOrigin + ivec2(1, 6),
        tileOrigin + ivec2(6, 6)
    );

    for (int a = 0; a < 5; ++a) {
        ivec2 p = clamp(anchors[a], ivec2(0), size - 1);
        float l0 = imageLoad(u_Grad0, p).z; // luma0
        vec2 samplePos = vec2(p) + cand;
        float l1 = sampleLuma1Bilinear(samplePos, size);
        sad += abs(l1 - l0);
    }

    // Bias towards zero motion to prevent drifting on uniform/flat textures
    if (tid == 0u) sad *= 0.90;

    s_candSAD[tid] = sad;
    s_candIdx[tid] = int(tid);

    barrier();

    // Parallel reduction across 64 candidates (in shared memory)
    if (tid < 32u) {
        if (s_candSAD[tid + 32u] < s_candSAD[tid]) {
            s_candSAD[tid] = s_candSAD[tid + 32u];
            s_candIdx[tid] = s_candIdx[tid + 32u];
        }
    }
    barrier();

    if (tid < 16u) {
        if (s_candSAD[tid + 16u] < s_candSAD[tid]) {
            s_candSAD[tid] = s_candSAD[tid + 16u];
            s_candIdx[tid] = s_candIdx[tid + 16u];
        }
    }
    barrier();

    if (tid < 8u) {
        if (s_candSAD[tid + 8u] < s_candSAD[tid]) {
            s_candSAD[tid] = s_candSAD[tid + 8u];
            s_candIdx[tid] = s_candIdx[tid + 8u];
        }
    }
    barrier();

    if (tid < 4u) {
        if (s_candSAD[tid + 4u] < s_candSAD[tid]) {
            s_candSAD[tid] = s_candSAD[tid + 4u];
            s_candIdx[tid] = s_candIdx[tid + 4u];
        }
    }
    barrier();

    if (tid < 2u) {
        if (s_candSAD[tid + 2u] < s_candSAD[tid]) {
            s_candSAD[tid] = s_candSAD[tid + 2u];
            s_candIdx[tid] = s_candIdx[tid + 2u];
        }
    }
    barrier();

    if (tid == 0u) {
        if (s_candSAD[1] < s_candSAD[0]) {
            s_candSAD[0] = s_candSAD[1];
            s_candIdx[0] = s_candIdx[1];
        }
        s_bestCoarseVector = kCoarseCandidates[s_candIdx[0]];
    }
    barrier();

    // All threads now have the dominant coarse motion vector for this tile!
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }

    // 2. Accumulate 2x2 Structure Tensor / Hessian H on reference template I0
    float H00 = 0.0;
    float H11 = 0.0;
    float H01 = 0.0;

    float patch_Ix[9];
    float patch_Iy[9];
    float patch_T[9];
    ivec2 patch_pos[9];

    for (int k = 0; k < 9; ++k) {
        ivec2 p = clamp(coord + kPatchOffsets[k], ivec2(0), size - 1);
        vec4 g = imageLoad(u_Grad0, p);
        patch_pos[k] = p;
        patch_Ix[k]  = g.x;
        patch_Iy[k]  = g.y;
        patch_T[k]   = g.z; // luma0

        H00 += g.x * g.x;
        H11 += g.y * g.y;
        H01 += g.x * g.y;
    }

    float lambda = 0.008;
    H00 += lambda;
    H11 += lambda;

    float detH = H00 * H11 - H01 * H01;
    float invDet = 1.0 / max(detH, 1e-7);
    mat2 invH = mat2(H11 * invDet, -H01 * invDet,
                    -H01 * invDet,  H00 * invDet);

    // 3. Select the best local seed around the coarse motion vector & static UI
    vec2 coarse = s_bestCoarseVector;
    vec2 localSeeds[10] = vec2[10](
        coarse,
        coarse + vec2(-1.5, 0.0), coarse + vec2(1.5, 0.0),
        coarse + vec2(0.0, -1.5), coarse + vec2(0.0, 1.5),
        vec2(0.0, 0.0),
        vec2(-1.5, 0.0), vec2(1.5, 0.0),
        vec2(0.0, -1.5), vec2(0.0, 1.5)
    );

    vec2 bestSeed = coarse;
    float minPatchSAD = 1e9;

    for (int s = 0; s < 10; ++s) {
        vec2 candSeed = localSeeds[s];
        float patchSAD = 0.0;
        for (int k = 0; k < 9; ++k) {
            vec2 samplePos = vec2(patch_pos[k]) + candSeed;
            float l1 = sampleLuma1Bilinear(samplePos, size);
            patchSAD += abs(l1 - patch_T[k]);
        }
        // Bias towards zero motion to protect static HUD / UI
        if (s == 5) patchSAD *= 0.90;

        if (patchSAD < minPatchSAD) {
            minPatchSAD = patchSAD;
            bestSeed = candSeed;
        }
    }

    // 4. Dense Inverse Compositional Gradient Descent Refinement (2 subpixel iterations)
    vec2 curFlow = bestSeed;
    for (int iter = 0; iter < 2; ++iter) {
        vec2 b = vec2(0.0, 0.0);
        for (int k = 0; k < 9; ++k) {
            vec2 samplePos = vec2(patch_pos[k]) + curFlow;
            float l1 = sampleLuma1Bilinear(samplePos, size);
            float residual = l1 - patch_T[k];
            b.x += patch_Ix[k] * residual;
            b.y += patch_Iy[k] * residual;
        }

        vec2 delta = -(invH * b);
        delta = clamp(delta, vec2(-1.5), vec2(1.5));
        curFlow += delta;
    }

    // 5. Compute final confidence & residual
    float finalDiff = 0.0;
    for (int k = 0; k < 9; ++k) {
        vec2 samplePos = vec2(patch_pos[k]) + curFlow;
        float l1 = sampleLuma1Bilinear(samplePos, size);
        finalDiff += abs(l1 - patch_T[k]);
    }
    finalDiff *= (1.0 / 9.0);

    // Scale to full-resolution screen pixel coordinates (1 low-res px = 4 full-res px)
    float scaleFactor = float(pc.full_width) / float(pc.grad_width);
    vec2 fullResVec = curFlow * scaleFactor;

    // Output: (flowX, flowY, residual, confidence)
    float confidence = clamp(1.0 - finalDiff * 3.0, 0.1, 1.0);
    imageStore(u_RawFlow, coord, vec4(fullResVec, finalDiff, confidence));
}
