#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rg16f) uniform readonly image2D u_RawMotion;
layout(binding = 1, rg16f) uniform writeonly image2D u_FilteredMotion;

layout(push_constant) uniform FilterPushConstants {
    int width;
    int height;
} pc;

float median9(inout float v[9]) {
    for (int i = 0; i < 5; ++i) {
        for (int j = i + 1; j < 9; ++j) {
            if (v[i] > v[j]) {
                float tmp = v[i];
                v[i] = v[j];
                v[j] = tmp;
            }
        }
    }
    return v[4];
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= pc.width || coord.y >= pc.height) {
        return;
    }

    ivec2 maxCoord = ivec2(pc.width - 1, pc.height - 1);
    float vx[9];
    float vy[9];
    int idx = 0;

    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 p = clamp(coord + ivec2(dx, dy), ivec2(0), maxCoord);
            vec2 v = imageLoad(u_RawMotion, p).xy;
            vx[idx] = v.x;
            vy[idx] = v.y;
            idx++;
        }
    }

    float medX = median9(vx);
    float medY = median9(vy);

    imageStore(u_FilteredMotion, coord, vec4(medX, medY, 0.0, 0.0));
}
