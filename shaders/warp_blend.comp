#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba8) uniform readonly image2D u_Frame0;
layout(binding = 1, rgba8) uniform readonly image2D u_Frame1;
layout(binding = 2, rgba8) uniform writeonly image2D u_OutImage;

layout(push_constant) uniform PushConstants {
    float alpha;
    int   width;
    int   height;
    int   show_hud;
    int   hud_protection;
    int   mode;
} pc;

shared float s_sad[64];

float getLuma(vec3 c) {
    return dot(c, vec3(0.299, 0.587, 0.114));
}

vec4 sampleBilinearFrame0(vec2 pos, ivec2 size) {
    pos = clamp(pos, vec2(0.0), vec2(size - 1));
    ivec2 i0 = ivec2(floor(pos));
    ivec2 i1 = min(i0 + ivec2(1, 1), size - 1);
    vec2 f = fract(pos);
    vec4 c00 = imageLoad(u_Frame0, ivec2(i0.x, i0.y));
    vec4 c10 = imageLoad(u_Frame0, ivec2(i1.x, i0.y));
    vec4 c01 = imageLoad(u_Frame0, ivec2(i0.x, i1.y));
    vec4 c11 = imageLoad(u_Frame0, ivec2(i1.x, i1.y));
    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

vec4 sampleBilinearFrame1(vec2 pos, ivec2 size) {
    pos = clamp(pos, vec2(0.0), vec2(size - 1));
    ivec2 i0 = ivec2(floor(pos));
    ivec2 i1 = min(i0 + ivec2(1, 1), size - 1);
    vec2 f = fract(pos);
    vec4 c00 = imageLoad(u_Frame1, ivec2(i0.x, i0.y));
    vec4 c10 = imageLoad(u_Frame1, ivec2(i1.x, i0.y));
    vec4 c01 = imageLoad(u_Frame1, ivec2(i0.x, i1.y));
    vec4 c11 = imageLoad(u_Frame1, ivec2(i1.x, i1.y));
    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

float evaluateVector(ivec2 d, ivec2 pixelCoord, bool inBounds, float l1, vec3 rgb1) {
    ivec2 sampleCoord = clamp(pixelCoord - d, ivec2(0), ivec2(pc.width - 1, pc.height - 1));
    vec4 samp0 = imageLoad(u_Frame0, sampleCoord);
    float l0_samp = getLuma(samp0.rgb);
    
    // Luminance diff + small color diff for robust matching
    float diff = inBounds ? (abs(l1 - l0_samp) + 0.2 * dot(abs(rgb1 - samp0.rgb), vec3(1.0))) : 0.0;
    
    // Preference bias for zero motion (prevents noise in flat/uniform areas)
    if (d.x == 0 && d.y == 0) {
        diff *= 0.90;
    }
    
    s_sad[gl_LocalInvocationIndex] = diff;
    barrier();
    
    if (gl_LocalInvocationIndex < 32) s_sad[gl_LocalInvocationIndex] += s_sad[gl_LocalInvocationIndex + 32];
    barrier();
    if (gl_LocalInvocationIndex < 16) s_sad[gl_LocalInvocationIndex] += s_sad[gl_LocalInvocationIndex + 16];
    barrier();
    if (gl_LocalInvocationIndex < 8) s_sad[gl_LocalInvocationIndex] += s_sad[gl_LocalInvocationIndex + 8];
    barrier();
    if (gl_LocalInvocationIndex < 4) s_sad[gl_LocalInvocationIndex] += s_sad[gl_LocalInvocationIndex + 4];
    barrier();
    if (gl_LocalInvocationIndex < 2) s_sad[gl_LocalInvocationIndex] += s_sad[gl_LocalInvocationIndex + 2];
    barrier();
    if (gl_LocalInvocationIndex == 0) s_sad[0] += s_sad[1];
    barrier();
    
    return s_sad[0];
}

void main() {
    ivec2 baseCoord = ivec2(gl_WorkGroupID.xy) * 8;
    ivec2 pixelCoord = baseCoord + ivec2(gl_LocalInvocationID.xy);
    bool inBounds = (pixelCoord.x < pc.width && pixelCoord.y < pc.height);
    ivec2 clampedCoord = clamp(pixelCoord, ivec2(0), ivec2(pc.width - 1, pc.height - 1));

    vec4 c1 = imageLoad(u_Frame1, clampedCoord);
    float l1 = getLuma(c1.rgb);

    vec4 c0 = imageLoad(u_Frame0, clampedCoord);
    float l0 = getLuma(c0.rgb);

    // 1. Hierarchical Diamond Motion Vector Estimation across 8x8 block
    ivec2 bestVec = ivec2(0, 0);
    float minSAD = 1e9;

    // Step 1: Coarse search
    const ivec2 coarse[9] = ivec2[9](
        ivec2(0, 0),
        ivec2(-12, 0), ivec2(12, 0),
        ivec2(0, -12), ivec2(0, 12),
        ivec2(-8, -8), ivec2(8, -8),
        ivec2(-8, 8),  ivec2(8, 8)
    );

    for (int i = 0; i < 9; ++i) {
        float sad = evaluateVector(coarse[i], pixelCoord, inBounds, l1, c1.rgb);
        if (sad < minSAD) {
            minSAD = sad;
            bestVec = coarse[i];
        }
    }

    // Step 2: Medium search (step size 4)
    const ivec2 step4[8] = ivec2[8](
        ivec2(-4, 0), ivec2(4, 0),
        ivec2(0, -4), ivec2(0, 4),
        ivec2(-4, -4), ivec2(4, -4),
        ivec2(-4, 4), ivec2(4, 4)
    );

    ivec2 center = bestVec;
    for (int i = 0; i < 8; ++i) {
        float sad = evaluateVector(center + step4[i], pixelCoord, inBounds, l1, c1.rgb);
        if (sad < minSAD) {
            minSAD = sad;
            bestVec = center + step4[i];
        }
    }

    // Step 3: Fine search (step size 2)
    const ivec2 step2[8] = ivec2[8](
        ivec2(-2, 0), ivec2(2, 0),
        ivec2(0, -2), ivec2(0, 2),
        ivec2(-2, -2), ivec2(2, -2),
        ivec2(-2, 2), ivec2(2, 2)
    );

    center = bestVec;
    for (int i = 0; i < 8; ++i) {
        float sad = evaluateVector(center + step2[i], pixelCoord, inBounds, l1, c1.rgb);
        if (sad < minSAD) {
            minSAD = sad;
            bestVec = center + step2[i];
        }
    }

    // Step 4: Pixel refinement (step size 1)
    const ivec2 step1[4] = ivec2[4](
        ivec2(-1, 0), ivec2(1, 0),
        ivec2(0, -1), ivec2(0, 1)
    );

    center = bestVec;
    for (int i = 0; i < 4; ++i) {
        float sad = evaluateVector(center + step1[i], pixelCoord, inBounds, l1, c1.rgb);
        if (sad < minSAD) {
            minSAD = sad;
            bestVec = center + step1[i];
        }
    }

    if (!inBounds) {
        return;
    }

    // 2. Scene Cut Detection
    // If average pixel difference across 64 pixels is large (> 0.45), scene changed completely
    if (minSAD > 0.45 * 64.0) {
        bestVec = ivec2(0, 0);
    }

    vec2 flow = vec2(bestVec);

    // 3. Static HUD / UI Protection
    // If block is moving, but this pixel did not change color, it is static HUD (crosshair, healthbar, minimap)
    if (pc.hud_protection == 1) {
        float localDiff = dot(abs(c1.rgb - c0.rgb), vec3(0.299, 0.587, 0.114));
        if (localDiff < 0.05 && length(flow) > 1.5) {
            flow = vec2(0.0);
        }
    }

    // 4. Spatial Motion Warping with Subpixel Bilinear Filtering
    ivec2 size = ivec2(pc.width, pc.height);

    // Forward motion extrapolation (+0.5 along vector):
    // Object moves along vector 'flow' from Frame 0 to Frame 1.
    // At intermediate time t + 0.5, object is at coord + 0.5 * flow.
    // Thus, at screen position 'pixelCoord', we sample the pixel from Frame 1 that was at:
    // pixelCoord - 0.5 * flow
    vec2 samplePos1 = vec2(pixelCoord) - flow * 0.5;
    vec4 warped1 = sampleBilinearFrame1(samplePos1, size);

    vec2 samplePos0 = vec2(pixelCoord) - flow * 1.5;
    vec4 warped0 = sampleBilinearFrame0(samplePos0, size);

    // Temporal blend: mostly Frame 1 (closest in time) with Frame 0 for occlusion filling
    vec4 finalColor = mix(warped0, warped1, 0.82);

    // 5. Visual HUD marker (neon green square in corner to verify generated frame)
    if (pc.show_hud == 1 && pixelCoord.x >= 6 && pixelCoord.x <= 18 && pixelCoord.y >= 6 && pixelCoord.y <= 18) {
        finalColor = vec4(0.0, 1.0, 0.4, 1.0);
    }

    imageStore(u_OutImage, pixelCoord, finalColor);
}

