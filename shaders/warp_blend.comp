#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba8) uniform readonly image2D u_Frame0;
layout(binding = 1, rgba8) uniform readonly image2D u_Frame1;
layout(binding = 2, rgba8) uniform writeonly image2D u_OutImage;
layout(binding = 3, rgba16f) uniform readonly image2D u_DenseFlow;

layout(push_constant) uniform PushConstants {
    float alpha;
    int   width;
    int   height;
    int   show_hud;
    int   hud_protection;
    int   mode;
    int   flow_width;
    int   flow_height;
} pc;

float getLuma(vec3 c) {
    return dot(c, vec3(0.299, 0.587, 0.114));
}

vec4 sampleBilinearFrame0(vec2 pos, ivec2 size) {
    pos = clamp(pos, vec2(0.0), vec2(size - 1));
    ivec2 i0 = ivec2(floor(pos));
    ivec2 i1 = min(i0 + ivec2(1, 1), size - 1);
    vec2 f = fract(pos);
    vec4 c00 = imageLoad(u_Frame0, ivec2(i0.x, i0.y));
    vec4 c10 = imageLoad(u_Frame0, ivec2(i1.x, i0.y));
    vec4 c01 = imageLoad(u_Frame0, ivec2(i0.x, i1.y));
    vec4 c11 = imageLoad(u_Frame0, ivec2(i1.x, i1.y));
    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

vec4 sampleBilinearFrame1(vec2 pos, ivec2 size) {
    pos = clamp(pos, vec2(0.0), vec2(size - 1));
    ivec2 i0 = ivec2(floor(pos));
    ivec2 i1 = min(i0 + ivec2(1, 1), size - 1);
    vec2 f = fract(pos);
    vec4 c00 = imageLoad(u_Frame1, ivec2(i0.x, i0.y));
    vec4 c10 = imageLoad(u_Frame1, ivec2(i1.x, i0.y));
    vec4 c01 = imageLoad(u_Frame1, ivec2(i0.x, i1.y));
    vec4 c11 = imageLoad(u_Frame1, ivec2(i1.x, i1.y));
    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

vec4 sampleDenseFlowBilinear(vec2 normPos, ivec2 flowSize) {
    vec2 flowPos = normPos * vec2(flowSize) - 0.5;
    flowPos = clamp(flowPos, vec2(0.0), vec2(flowSize - 1));
    ivec2 i0 = ivec2(floor(flowPos));
    ivec2 i1 = min(i0 + ivec2(1, 1), flowSize - 1);
    vec2 f = fract(flowPos);

    vec4 v00 = imageLoad(u_DenseFlow, ivec2(i0.x, i0.y));
    vec4 v10 = imageLoad(u_DenseFlow, ivec2(i1.x, i0.y));
    vec4 v01 = imageLoad(u_DenseFlow, ivec2(i0.x, i1.y));
    vec4 v11 = imageLoad(u_DenseFlow, ivec2(i1.x, i1.y));

    return mix(mix(v00, v10, f.x), mix(v01, v11, f.x), f.y);
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    if (pixelCoord.x >= pc.width || pixelCoord.y >= pc.height) {
        return;
    }

    ivec2 size = ivec2(pc.width, pc.height);
    ivec2 maxCoord = size - ivec2(1, 1);
    ivec2 flowSize = ivec2(pc.flow_width, pc.flow_height);
    vec2 normPos = (vec2(pixelCoord) + 0.5) / vec2(size);

    // 1. Bilinearly interpolated continuous motion vector and occlusion factor
    vec4 flowData = sampleDenseFlowBilinear(normPos, flowSize);
    vec2 flow = flowData.xy;
    float occ = flowData.w;

    // 2. Symmetric bidirectional sampling along the motion trajectory
    vec2 pos0 = vec2(pixelCoord) - flow * 0.5;
    vec2 pos1 = vec2(pixelCoord) + flow * 0.5;
    vec4 sample0 = sampleBilinearFrame0(pos0, size);
    vec4 sample1 = sampleBilinearFrame1(pos1, size);

    // 3. Static UI / HUD Protection
    if (pc.hud_protection == 1 && length(flow) > 1.5) {
        vec3 c1_here = imageLoad(u_Frame1, pixelCoord).rgb;
        vec3 c0_here = imageLoad(u_Frame0, pixelCoord).rgb;
        float temporalDiff = dot(abs(c1_here - c0_here), vec3(0.299, 0.587, 0.114));

        vec3 c_right = imageLoad(u_Frame1, min(pixelCoord + ivec2(1, 0), maxCoord)).rgb;
        vec3 c_down  = imageLoad(u_Frame1, min(pixelCoord + ivec2(0, 1), maxCoord)).rgb;
        float spatialEdge = max(
            dot(abs(c_right - c1_here), vec3(0.299, 0.587, 0.114)),
            dot(abs(c_down - c1_here), vec3(0.299, 0.587, 0.114))
        );

        if (temporalDiff < 0.05 && spatialEdge > 0.08) {
            sample0 = imageLoad(u_Frame0, pixelCoord);
            sample1 = imageLoad(u_Frame1, pixelCoord);
            occ = 1.0;
        }
    }

    // 4. True Chronological Symmetric Interpolation with Occlusion-Aware Soft Blending
    vec4 motionBlended = mix(sample0, sample1, 0.5);
    float blendWeight = clamp(occ, 0.35, 1.0);
    vec4 finalColor = mix(sample1, motionBlended, blendWeight);

    // Visual HUD marker (neon green square in top-left corner)
    if (pc.show_hud == 1 && pixelCoord.x >= 6 && pixelCoord.x <= 18 && pixelCoord.y >= 6 && pixelCoord.y <= 18) {
        finalColor = vec4(0.0, 1.0, 0.4, 1.0);
    }

    imageStore(u_OutImage, pixelCoord, finalColor);
}
