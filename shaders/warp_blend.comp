#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform readonly image2D u_Frame0;
layout(binding = 1, rgba8) uniform readonly image2D u_Frame1;
layout(binding = 2, rgba8) uniform writeonly image2D u_OutImage;

layout(push_constant) uniform PushConstants {
    float alpha;
    int   width;
    int   height;
    int   show_hud;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= pc.width || coord.y >= pc.height) {
        return;
    }

    // Optional debug indicator on generated frame to prove visual delivery (neon green square)
    if (pc.show_hud == 1 && coord.x >= 6 && coord.x <= 18 && coord.y >= 6 && coord.y <= 18) {
        imageStore(u_OutImage, coord, vec4(0.0, 1.0, 0.4, 1.0));
        return;
    }

    vec4 c0 = imageLoad(u_Frame0, coord);
    vec4 c1 = imageLoad(u_Frame1, coord);

    // Forward motion extrapolation (project +0.5 frame ahead of Frame N)
    vec4 delta = c1 - c0;
    delta = clamp(delta, vec4(-0.25), vec4(0.25));
    vec4 extrapolated = clamp(c1 + delta * pc.alpha, 0.0, 1.0);

    imageStore(u_OutImage, coord, extrapolated);
}

