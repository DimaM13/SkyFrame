#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba8) uniform readonly image2D u_Frame0;
layout(binding = 1, rgba8) uniform readonly image2D u_Frame1;
layout(binding = 2, rgba8) uniform writeonly image2D u_OutImage;

layout(push_constant) uniform PushConstants {
    float alpha;
    int   width;
    int   height;
    int   show_hud;
    int   hud_protection;
    int   mode;
} pc;

shared float s_candSAD[64];
shared ivec2 s_bestVec;

float getLuma(vec3 c) {
    return dot(c, vec3(0.299, 0.587, 0.114));
}

vec4 sampleBilinearFrame0(vec2 pos, ivec2 size) {
    pos = clamp(pos, vec2(0.0), vec2(size - 1));
    ivec2 i0 = ivec2(floor(pos));
    ivec2 i1 = min(i0 + ivec2(1, 1), size - 1);
    vec2 f = fract(pos);
    vec4 c00 = imageLoad(u_Frame0, ivec2(i0.x, i0.y));
    vec4 c10 = imageLoad(u_Frame0, ivec2(i1.x, i0.y));
    vec4 c01 = imageLoad(u_Frame0, ivec2(i0.x, i1.y));
    vec4 c11 = imageLoad(u_Frame0, ivec2(i1.x, i1.y));
    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

vec4 sampleBilinearFrame1(vec2 pos, ivec2 size) {
    pos = clamp(pos, vec2(0.0), vec2(size - 1));
    ivec2 i0 = ivec2(floor(pos));
    ivec2 i1 = min(i0 + ivec2(1, 1), size - 1);
    vec2 f = fract(pos);
    vec4 c00 = imageLoad(u_Frame1, ivec2(i0.x, i0.y));
    vec4 c10 = imageLoad(u_Frame1, ivec2(i1.x, i0.y));
    vec4 c01 = imageLoad(u_Frame1, ivec2(i0.x, i1.y));
    vec4 c11 = imageLoad(u_Frame1, ivec2(i1.x, i1.y));
    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

// 49 motion candidates covering radii 0, 2, 4, 8, 14, 22, 30 px
const ivec2 kCandidates[49] = ivec2[49](
    ivec2(0, 0),
    // Radius 4
    ivec2(-4, 0), ivec2(4, 0), ivec2(0, -4), ivec2(0, 4),
    ivec2(-4, -4), ivec2(4, -4), ivec2(-4, 4), ivec2(4, 4),
    // Radius 8
    ivec2(-8, 0), ivec2(8, 0), ivec2(0, -8), ivec2(0, 8),
    ivec2(-8, -8), ivec2(8, -8), ivec2(-8, 8), ivec2(8, 8),
    // Radius 14
    ivec2(-14, 0), ivec2(14, 0), ivec2(0, -14), ivec2(0, 14),
    ivec2(-14, -8), ivec2(14, -8), ivec2(-14, 8), ivec2(14, 8),
    ivec2(-8, -14), ivec2(8, -14), ivec2(-8, 14), ivec2(8, 14),
    // Radius 22
    ivec2(-22, 0), ivec2(22, 0), ivec2(0, -22), ivec2(0, 22),
    ivec2(-22, -12), ivec2(22, -12), ivec2(-22, 12), ivec2(22, 12),
    // Radius 30
    ivec2(-30, 0), ivec2(30, 0), ivec2(0, -30), ivec2(0, 30),
    ivec2(-30, -16), ivec2(30, -16), ivec2(-30, 16), ivec2(30, 16),
    // Radius 2
    ivec2(-2, 0), ivec2(2, 0), ivec2(0, -2), ivec2(0, 2)
);

// 9 sample points inside 8x8 block
const ivec2 kBlockSamples[9] = ivec2[9](
    ivec2(1, 1), ivec2(4, 1), ivec2(7, 1),
    ivec2(1, 4), ivec2(4, 4), ivec2(7, 4),
    ivec2(1, 7), ivec2(4, 7), ivec2(7, 7)
);

void main() {
    ivec2 baseCoord = ivec2(gl_WorkGroupID.xy) * 8;
    ivec2 pixelCoord = baseCoord + ivec2(gl_LocalInvocationID.xy);
    bool inBounds = (pixelCoord.x < pc.width && pixelCoord.y < pc.height);
    ivec2 maxCoord = ivec2(pc.width - 1, pc.height - 1);

    uint tid = gl_LocalInvocationIndex; // 0..63

    // 1. Parallel evaluation of all 49 motion candidates simultaneously across workgroup threads
    if (tid < 49) {
        ivec2 cand = kCandidates[tid];
        float diff = 0.0;
        for (int i = 0; i < 9; ++i) {
            ivec2 p1 = clamp(baseCoord + kBlockSamples[i], ivec2(0), maxCoord);
            ivec2 p0 = clamp(p1 - cand, ivec2(0), maxCoord);
            vec3 c1 = imageLoad(u_Frame1, p1).rgb;
            vec3 c0 = imageLoad(u_Frame0, p0).rgb;
            diff += abs(getLuma(c1) - getLuma(c0)) + 0.2 * dot(abs(c1 - c0), vec3(1.0));
        }

        // Slight zero-bias to stabilize uniform / low-contrast regions
        if (cand.x == 0 && cand.y == 0) {
            diff *= 0.88;
        }

        s_candSAD[tid] = diff;
    } else {
        s_candSAD[tid] = 1e9;
    }

    barrier(); // Barrier 1: All 49 candidates evaluated

    // 2. Thread 0 finds the best motion vector
    if (tid == 0) {
        float minVal = s_candSAD[0];
        int bestIdx = 0;
        for (int i = 1; i < 49; ++i) {
            if (s_candSAD[i] < minVal) {
                minVal = s_candSAD[i];
                bestIdx = i;
            }
        }

        // Scene cut detection: if best SAD is very high (> 0.55 avg per sample), reset to 0
        if (minVal > 0.55 * 9.0) {
            s_bestVec = ivec2(0, 0);
        } else {
            s_bestVec = kCandidates[bestIdx];
        }
    }

    barrier(); // Barrier 2: Best vector shared with all 64 threads

    if (!inBounds) {
        return;
    }

    ivec2 clampedCoord = clamp(pixelCoord, ivec2(0), maxCoord);
    vec2 flow = vec2(s_bestVec);

    // 3. Static UI / HUD Protection:
    // A genuine HUD element has a sharp spatial edge (text/icons/crosshair)
    // AND its color did not change between Frame 0 and Frame 1.
    // Flat textures (sky, road, walls) are NOT HUD and will not be zeroed out.
    if (pc.hud_protection == 1 && length(flow) > 1.5) {
        vec3 c1_here = imageLoad(u_Frame1, clampedCoord).rgb;
        vec3 c0_here = imageLoad(u_Frame0, clampedCoord).rgb;
        float temporalDiff = dot(abs(c1_here - c0_here), vec3(0.299, 0.587, 0.114));

        vec3 c_right = imageLoad(u_Frame1, min(clampedCoord + ivec2(1, 0), maxCoord)).rgb;
        vec3 c_down  = imageLoad(u_Frame1, min(clampedCoord + ivec2(0, 1), maxCoord)).rgb;
        float spatialEdge = max(
            dot(abs(c_right - c1_here), vec3(0.299, 0.587, 0.114)),
            dot(abs(c_down - c1_here), vec3(0.299, 0.587, 0.114))
        );

        if (temporalDiff < 0.05 && spatialEdge > 0.08) {
            flow = vec2(0.0);
        }
    }

    // 4. True Chronological Symmetric Interpolation at phase 0.5:
    // Motion vector 'flow' points from Frame 0 to Frame 1.
    // At intermediate time t = 0.5:
    // Object at screen position pixelCoord was at:
    // Frame 0: pixelCoord - 0.5 * flow
    // Frame 1: pixelCoord + 0.5 * flow
    ivec2 size = ivec2(pc.width, pc.height);
    vec2 pos0 = vec2(pixelCoord) - flow * 0.5;
    vec2 pos1 = vec2(pixelCoord) + flow * 0.5;

    vec4 sample0 = sampleBilinearFrame0(pos0, size);
    vec4 sample1 = sampleBilinearFrame1(pos1, size);

    vec4 finalColor = mix(sample0, sample1, 0.5);

    // 5. Visual HUD marker (neon green square in corner to verify generated frame delivery)
    if (pc.show_hud == 1 && pixelCoord.x >= 6 && pixelCoord.x <= 18 && pixelCoord.y >= 6 && pixelCoord.y <= 18) {
        finalColor = vec4(0.0, 1.0, 0.4, 1.0);
    }

    imageStore(u_OutImage, pixelCoord, finalColor);
}
