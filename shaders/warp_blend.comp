#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba8) uniform readonly image2D u_Frame0;
layout(binding = 1, rgba8) uniform readonly image2D u_Frame1;
layout(binding = 2, rgba8) uniform writeonly image2D u_OutImage;

layout(push_constant) uniform PushConstants {
    float alpha;
    int   width;
    int   height;
    int   show_hud;
    int   hud_protection;
    int   mode;
} pc;

shared float s_candSAD[64];
shared int   s_candIdx[64];
shared ivec2 s_bestVec;

float getLuma(vec3 c) {
    return dot(c, vec3(0.299, 0.587, 0.114));
}

vec4 sampleBilinearFrame0(vec2 pos, ivec2 size) {
    pos = clamp(pos, vec2(0.0), vec2(size - 1));
    ivec2 i0 = ivec2(floor(pos));
    ivec2 i1 = min(i0 + ivec2(1, 1), size - 1);
    vec2 f = fract(pos);
    vec4 c00 = imageLoad(u_Frame0, ivec2(i0.x, i0.y));
    vec4 c10 = imageLoad(u_Frame0, ivec2(i1.x, i0.y));
    vec4 c01 = imageLoad(u_Frame0, ivec2(i0.x, i1.y));
    vec4 c11 = imageLoad(u_Frame0, ivec2(i1.x, i1.y));
    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

vec4 sampleBilinearFrame1(vec2 pos, ivec2 size) {
    pos = clamp(pos, vec2(0.0), vec2(size - 1));
    ivec2 i0 = ivec2(floor(pos));
    ivec2 i1 = min(i0 + ivec2(1, 1), size - 1);
    vec2 f = fract(pos);
    vec4 c00 = imageLoad(u_Frame1, ivec2(i0.x, i0.y));
    vec4 c10 = imageLoad(u_Frame1, ivec2(i1.x, i0.y));
    vec4 c01 = imageLoad(u_Frame1, ivec2(i0.x, i1.y));
    vec4 c11 = imageLoad(u_Frame1, ivec2(i1.x, i1.y));
    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

// 64 motion candidates covering radii 0, 1, 2, 4, 8, 14, 24, 36, 48 px
// Evaluated across all 64 threads of the 8x8 workgroup simultaneously
const ivec2 kCandidates[64] = ivec2[64](
    ivec2(0, 0),
    // Radius 1 (subtle motion / fine edge)
    ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1),
    // Radius 2
    ivec2(-2, 0), ivec2(2, 0), ivec2(0, -2), ivec2(0, 2),
    ivec2(-2, -2), ivec2(2, -2), ivec2(-2, 2), ivec2(2, 2),
    // Radius 4
    ivec2(-4, 0), ivec2(4, 0), ivec2(0, -4), ivec2(0, 4),
    ivec2(-4, -4), ivec2(4, -4), ivec2(-4, 4), ivec2(4, 4),
    // Radius 8
    ivec2(-8, 0), ivec2(8, 0), ivec2(0, -8), ivec2(0, 8),
    ivec2(-8, -8), ivec2(8, -8), ivec2(-8, 8), ivec2(8, 8),
    // Radius 14
    ivec2(-14, 0), ivec2(14, 0), ivec2(0, -14), ivec2(0, 14),
    ivec2(-14, -8), ivec2(14, -8), ivec2(-14, 8), ivec2(14, 8),
    ivec2(-8, -14), ivec2(8, -14), ivec2(-8, 14), ivec2(8, 14),
    // Radius 24
    ivec2(-24, 0), ivec2(24, 0), ivec2(0, -24), ivec2(0, 24),
    ivec2(-24, -14), ivec2(24, -14), ivec2(-24, 14), ivec2(24, 14),
    // Radius 36
    ivec2(-36, 0), ivec2(36, 0), ivec2(0, -36), ivec2(0, 36),
    ivec2(-36, -20), ivec2(36, -20), ivec2(-36, 20), ivec2(36, 20),
    // Radius 48 (wide camera pan)
    ivec2(-48, 0), ivec2(48, 0), ivec2(0, -48), ivec2(0, 48),
    ivec2(-48, -24), ivec2(48, -24), ivec2(-48, 24)
);

// 16 sample points uniformly covering the 8x8 block (4x4 grid)
const ivec2 kBlockSamples[16] = ivec2[16](
    ivec2(0, 0), ivec2(2, 0), ivec2(5, 0), ivec2(7, 0),
    ivec2(0, 2), ivec2(2, 2), ivec2(5, 2), ivec2(7, 2),
    ivec2(0, 5), ivec2(2, 5), ivec2(5, 5), ivec2(7, 5),
    ivec2(0, 7), ivec2(2, 7), ivec2(5, 7), ivec2(7, 7)
);

void main() {
    ivec2 baseCoord = ivec2(gl_WorkGroupID.xy) * 8;
    ivec2 pixelCoord = baseCoord + ivec2(gl_LocalInvocationID.xy);
    bool inBounds = (pixelCoord.x < pc.width && pixelCoord.y < pc.height);
    ivec2 maxCoord = ivec2(pc.width - 1, pc.height - 1);

    uint tid = gl_LocalInvocationIndex; // 0..63

    // 1. Parallel evaluation of all 64 motion candidates across the 64 workgroup threads
    ivec2 cand = kCandidates[tid];
    float diff = 0.0;
    for (int i = 0; i < 16; ++i) {
        ivec2 p1 = clamp(baseCoord + kBlockSamples[i], ivec2(0), maxCoord);
        ivec2 p0 = clamp(p1 - cand, ivec2(0), maxCoord);
        vec3 c1 = imageLoad(u_Frame1, p1).rgb;
        vec3 c0 = imageLoad(u_Frame0, p0).rgb;
        diff += abs(getLuma(c1) - getLuma(c0)) + 0.2 * dot(abs(c1 - c0), vec3(1.0));
    }

    // Zero-bias on pure zero candidate to prevent drift in flat areas
    if (cand.x == 0 && cand.y == 0) {
        diff *= 0.94;
    }

    s_candSAD[tid] = diff;
    s_candIdx[tid] = int(tid);

    barrier(); // Barrier 1: All 64 candidates evaluated

    // 2. Parallel reduction to find minimum candidate in 2 steps
    if (tid < 32) {
        if (s_candSAD[tid + 32] < s_candSAD[tid]) {
            s_candSAD[tid] = s_candSAD[tid + 32];
            s_candIdx[tid] = s_candIdx[tid + 32];
        }
    }
    barrier();
    if (tid < 16) {
        if (s_candSAD[tid + 16] < s_candSAD[tid]) {
            s_candSAD[tid] = s_candSAD[tid + 16];
            s_candIdx[tid] = s_candIdx[tid + 16];
        }
    }
    barrier();

    if (tid == 0) {
        float minVal = s_candSAD[0];
        int bestIdx = s_candIdx[0];
        for (int i = 1; i < 16; ++i) {
            if (s_candSAD[i] < minVal) {
                minVal = s_candSAD[i];
                bestIdx = s_candIdx[i];
            }
        }
        s_bestVec = kCandidates[bestIdx];
    }

    barrier(); // Barrier 2: Best vector shared with all 64 threads

    if (!inBounds) {
        return;
    }

    ivec2 clampedCoord = clamp(pixelCoord, ivec2(0), maxCoord);
    vec2 flow = vec2(s_bestVec);
    ivec2 size = ivec2(pc.width, pc.height);

    // Initial symmetric samples
    vec2 pos0 = vec2(pixelCoord) - flow * 0.5;
    vec2 pos1 = vec2(pixelCoord) + flow * 0.5;
    vec4 sample0 = sampleBilinearFrame0(pos0, size);
    vec4 sample1 = sampleBilinearFrame1(pos1, size);
    float bestDiff = dot(abs(sample0.rgb - sample1.rgb), vec3(0.299, 0.587, 0.114));

    // 3. Per-pixel fine edge refinement:
    // If the block vector produces a slight color mismatch at boundary edges,
    // test 4 fine 1-pixel neighbor steps to snap the vector directly to moving edges
    if (bestDiff > 0.08) {
        const ivec2 kFine[4] = ivec2[4](ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
        for (int i = 0; i < 4; ++i) {
            vec2 testFlow = flow + vec2(kFine[i]);
            vec2 tp0 = vec2(pixelCoord) - testFlow * 0.5;
            vec2 tp1 = vec2(pixelCoord) + testFlow * 0.5;
            vec4 ts0 = sampleBilinearFrame0(tp0, size);
            vec4 ts1 = sampleBilinearFrame1(tp1, size);
            float tdiff = dot(abs(ts0.rgb - ts1.rgb), vec3(0.299, 0.587, 0.114));
            if (tdiff < bestDiff) {
                bestDiff = tdiff;
                flow = testFlow;
                sample0 = ts0;
                sample1 = ts1;
            }
        }
    }

    // 4. Static UI / HUD Protection:
    // A genuine HUD element has a sharp spatial edge (text/icons/crosshair)
    // AND its color did not change between Frame 0 and Frame 1.
    if (pc.hud_protection == 1 && length(flow) > 1.5) {
        vec3 c1_here = imageLoad(u_Frame1, clampedCoord).rgb;
        vec3 c0_here = imageLoad(u_Frame0, clampedCoord).rgb;
        float temporalDiff = dot(abs(c1_here - c0_here), vec3(0.299, 0.587, 0.114));

        vec3 c_right = imageLoad(u_Frame1, min(clampedCoord + ivec2(1, 0), maxCoord)).rgb;
        vec3 c_down  = imageLoad(u_Frame1, min(clampedCoord + ivec2(0, 1), maxCoord)).rgb;
        float spatialEdge = max(
            dot(abs(c_right - c1_here), vec3(0.299, 0.587, 0.114)),
            dot(abs(c_down - c1_here), vec3(0.299, 0.587, 0.114))
        );

        if (temporalDiff < 0.05 && spatialEdge > 0.08) {
            flow = vec2(0.0);
            sample0 = imageLoad(u_Frame0, clampedCoord);
            sample1 = imageLoad(u_Frame1, clampedCoord);
            bestDiff = 0.0;
        }
    }

    // 5. True Chronological Symmetric Interpolation at phase 0.5:
    // If samples agree (bestDiff < 0.05), full 50/50 temporal blend for maximum smoothness.
    // If samples disagree (occlusion/disocclusion), smoothly dissolve into Frame 1 (sharp native frame),
    // eliminating ghosting and dissolving block seams completely.
    float blendWeight = smoothstep(0.22, 0.05, bestDiff);
    vec4 motionBlended = mix(sample0, sample1, 0.5);
    vec4 finalColor = mix(sample1, motionBlended, blendWeight);

    // Visual HUD marker (neon green square in corner to verify generated frame delivery)
    if (pc.show_hud == 1 && pixelCoord.x >= 6 && pixelCoord.x <= 18 && pixelCoord.y >= 6 && pixelCoord.y <= 18) {
        finalColor = vec4(0.0, 1.0, 0.4, 1.0);
    }

    imageStore(u_OutImage, pixelCoord, finalColor);
}
