#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba8) uniform readonly image2D u_Frame0;
layout(binding = 1, rgba8) uniform readonly image2D u_Frame1;
layout(binding = 2, rg16f) uniform writeonly image2D u_MotionField;

layout(push_constant) uniform MotionPushConstants {
    int width;
    int height;
} pc;

shared float s_candSAD[64];
shared int   s_candIdx[64];
shared vec3  s_block1[8][8];

float getLuma(vec3 c) {
    return dot(c, vec3(0.299, 0.587, 0.114));
}

// 64 motion candidates covering uniform 360-degree directions across 7 speed radii (2, 5, 9, 15, 23, 34, 48 px)
const ivec2 kCandidates[64] = ivec2[64](
    ivec2(0, 0), ivec2(2, 0), ivec2(2, 1), ivec2(0, 2),
    ivec2(-1, 2), ivec2(-2, 1), ivec2(-2, -1), ivec2(-1, -2),
    ivec2(0, -2), ivec2(2, -1), ivec2(5, 0), ivec2(4, 3),
    ivec2(1, 5), ivec2(-2, 4), ivec2(-5, 2), ivec2(-5, -2),
    ivec2(-3, -4), ivec2(1, -5), ivec2(4, -3), ivec2(9, 0),
    ivec2(7, 6), ivec2(2, 9), ivec2(-4, 8), ivec2(-8, 3),
    ivec2(-8, -3), ivec2(-5, -8), ivec2(2, -9), ivec2(7, -6),
    ivec2(15, 0), ivec2(11, 10), ivec2(3, 15), ivec2(-7, 13),
    ivec2(-14, 5), ivec2(-14, -5), ivec2(-8, -13), ivec2(3, -15),
    ivec2(11, -10), ivec2(23, 0), ivec2(18, 15), ivec2(4, 23),
    ivec2(-11, 20), ivec2(-22, 8), ivec2(-22, -8), ivec2(-12, -20),
    ivec2(4, -23), ivec2(18, -15), ivec2(34, 0), ivec2(26, 22),
    ivec2(6, 33), ivec2(-17, 29), ivec2(-32, 12), ivec2(-32, -12),
    ivec2(-17, -29), ivec2(6, -33), ivec2(26, -22), ivec2(48, 0),
    ivec2(37, 31), ivec2(8, 47), ivec2(-24, 42), ivec2(-45, 16),
    ivec2(-45, -16), ivec2(-24, -42), ivec2(8, -47), ivec2(37, -31)
);

// 16 sample points uniformly covering the 8x8 block (4x4 grid)
const ivec2 kBlockSamples[16] = ivec2[16](
    ivec2(0, 0), ivec2(2, 0), ivec2(5, 0), ivec2(7, 0),
    ivec2(0, 2), ivec2(2, 2), ivec2(5, 2), ivec2(7, 2),
    ivec2(0, 5), ivec2(2, 5), ivec2(5, 5), ivec2(7, 5),
    ivec2(0, 7), ivec2(2, 7), ivec2(5, 7), ivec2(7, 7)
);

void main() {
    ivec2 blockCoord = ivec2(gl_WorkGroupID.xy);
    ivec2 baseCoord = blockCoord * 8;
    ivec2 maxCoord = ivec2(pc.width - 1, pc.height - 1);
    uint tid = gl_LocalInvocationIndex; // 0..63

    // 1. Cooperative load of Frame 1 block into shared memory (1 load per thread)
    ivec2 lid = ivec2(gl_LocalInvocationID.xy);
    ivec2 p1 = clamp(baseCoord + lid, ivec2(0), maxCoord);
    s_block1[lid.y][lid.x] = imageLoad(u_Frame1, p1).rgb;

    barrier(); // Barrier 1: Block 1 ready in shared memory

    // 2. Parallel evaluation of all 64 motion candidates across 64 threads
    ivec2 cand = kCandidates[tid];
    float diff = 0.0;
    for (int i = 0; i < 16; ++i) {
        ivec2 s = kBlockSamples[i];
        vec3 c1 = s_block1[s.y][s.x];
        ivec2 p0 = clamp(baseCoord + s - cand, ivec2(0), maxCoord);
        vec3 c0 = imageLoad(u_Frame0, p0).rgb;
        diff += abs(getLuma(c1) - getLuma(c0)) + 0.2 * dot(abs(c1 - c0), vec3(1.0));
    }

    // Zero-bias to prevent drift on flat/static textures
    if (cand.x == 0 && cand.y == 0) {
        diff *= 0.94;
    }

    s_candSAD[tid] = diff;
    s_candIdx[tid] = int(tid);

    barrier(); // Barrier 2: All 64 candidates evaluated

    // 3. Parallel reduction in shared memory to find best vector
    if (tid < 32) {
        if (s_candSAD[tid + 32] < s_candSAD[tid]) {
            s_candSAD[tid] = s_candSAD[tid + 32];
            s_candIdx[tid] = s_candIdx[tid + 32];
        }
    }
    barrier();
    if (tid < 16) {
        if (s_candSAD[tid + 16] < s_candSAD[tid]) {
            s_candSAD[tid] = s_candSAD[tid + 16];
            s_candIdx[tid] = s_candIdx[tid + 16];
        }
    }
    barrier();

    if (tid == 0) {
        float minVal = s_candSAD[0];
        int bestIdx = s_candIdx[0];
        for (int i = 1; i < 16; ++i) {
            if (s_candSAD[i] < minVal) {
                minVal = s_candSAD[i];
                bestIdx = s_candIdx[i];
            }
        }
        vec2 bestVec = vec2(kCandidates[bestIdx]);
        imageStore(u_MotionField, blockCoord, vec4(bestVec, 0.0, 0.0));
    }
}
